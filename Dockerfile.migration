FROM node:22.13.1-bookworm-slim AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22.13.1-bookworm-slim AS runtime

# This public CA bundle permits TLS verification for Amazon RDS without
# embedding any database endpoint or credential in the image.
ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /etc/ssl/certs/rds-global-bundle.pem
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && chmod 0644 /etc/ssl/certs/rds-global-bundle.pem \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem
WORKDIR /app

RUN groupadd --gid 10001 wonderlab \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin wonderlab

# cli.ts discovers SQL migrations relative to this source tree. Credentials are
# deliberately absent: the Job supplies DATABASE_SECRET_FILE from CSI at run time.
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY server/packages ./server/packages

USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./node_modules/.bin/tsx", "--tsconfig", "server/tsconfig.json", "server/packages/db/src/cli.ts", "migrate"]
