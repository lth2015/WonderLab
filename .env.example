# Copy to .env (never commit it). Names match yuha's, so the same values work.

# ── TokenStars (OpenAI-compatible gateway, https://www.tokenstars.ai)
TOKENSTARS_BASE_URL=https://www.tokenstars.ai
TOKENSTARS_API_KEY=
# Text model for 一句成境 and poem choice, exactly as TokenStars names it (e.g. gpt-5.4-nano).
TOKENSTARS_MODEL_ID=
# Image model for scripts/gen-art.mjs (one-off textures), e.g. gpt-image-1.
TOKENSTARS_IMAGE_MODEL_ID=
# Optional overrides.
TOKENSTARS_CHAT_PATH=/v1/chat/completions
TOKENSTARS_IMAGE_PATH=/v1/images/generations
TOKENSTARS_REQUEST_ID_HEADER=x-request-id

# ── API server (npm run server)
PORT=8787
HOST=127.0.0.1
# Web origins allowed to call the API, comma separated (empty = any, for local dev only).
ALLOWED_ORIGINS=
# Invite tokens for 一句成境's AI, comma separated, 8+ characters each. A tester
# opens the site once with ?invite=<token>. Remove a token to revoke it.
INVITE_TOKENS=
# Three spending caps for the AI (docs/02 §5.3), in yen.
SCENE_DAILY_PER_INVITE=60
SCENE_DAILY_BUDGET_JPY=300
SCENE_TOTAL_BUDGET_JPY=5000
# Estimated yen per model call (as in yuha) until real billing data is in.
TOKENSTARS_COST_MINOR_PER_REQUEST=0.2
# Salt for the sentence cache keys (random per start when empty).
SCENE_CACHE_SALT=
