# Copy to .env (never commit it). Names match yuha's, so the same values work.

# ── TokenStars (OpenAI-compatible gateway, https://www.tokenstars.ai)
TOKENSTARS_BASE_URL=https://www.tokenstars.ai
TOKENSTARS_API_KEY=
# Text model for 一句成境 and poem choice, exactly as TokenStars names it (e.g. gpt-5.4-nano).
TOKENSTARS_MODEL_ID=
# Image model for scripts/gen-art.mjs (one-off textures), e.g. gpt-image-1.
TOKENSTARS_IMAGE_MODEL_ID=
# Optional overrides.
TOKENSTARS_CHAT_PATH=/v1/chat/completions
TOKENSTARS_IMAGE_PATH=/v1/images/generations
TOKENSTARS_REQUEST_ID_HEADER=x-request-id

# ── API server (npm run server)
# demo        | dev sign-in and simulated payments, nothing real
# integration | real services as credentials allow; Stripe test mode
# production  | Google sign-in and real payments only
RUN_MODE=demo
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
# More web origins allowed to call the API, comma separated — e.g. the
# Network address Vite prints, when testing from a phone.
ALLOWED_ORIGINS=
# Invite tokens for 一句成境's AI, comma separated, 8+ characters each. A tester
# opens the site once with ?invite=<token>. Remove a token to revoke it.
INVITE_TOKENS=
# Three spending caps for the AI (docs/02 §5.3), in yen.
SCENE_DAILY_PER_INVITE=60
SCENE_DAILY_BUDGET_JPY=300
SCENE_TOTAL_BUDGET_JPY=5000
# Estimated yen per model call (as in yuha) until real billing data is in.
TOKENSTARS_COST_MINOR_PER_REQUEST=0.2
# Salt for the sentence cache keys (random per start when empty).
SCENE_CACHE_SALT=

# ═══════════════════════════════════════════ accounts and payments
# Ported from yuha (same names, same rules). All of it is OFF until
# DATABASE_URL is set; without it the API still serves 一句成境.

# ── database: MySQL 8.0+ (`npm run db:up` starts one; `npm run db:migrate`)
DATABASE_URL=
# DATABASE_URL=mysql://wonderlab:wonderlab_local@127.0.0.1:53306/wonderlab
DATABASE_POOL_MAX=10
# Required true in production.
DATABASE_SSL=false
# Run the webhook, chain-scan and maintenance loops inside the API process.
RUN_WORKER=true

# ── identity
# dev | google.  "dev" is rejected in production mode.
AUTH_ADAPTER=dev
# HMAC secret for local dev session tokens. Generate: openssl rand -hex 32
DEV_AUTH_SECRET=
# Who may use the development sign-in (no password). Empty = anyone.
# "@domain" admits a whole domain, anything else one exact address.
DEV_LOGIN_ALLOWLIST=
# "Sign in with Google": an OAuth 2.0 client of type Web application in the
# Google Cloud Console (APIs & Services → Credentials). The button appears as
# soon as all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Absolute, byte-identical to an "Authorized redirect URI", pointing at THE
# API's /v1/auth/google/callback — NOT the web app's /auth/google/callback,
# which is where the API sends the browser afterwards. The API refuses to
# start if the path, a query string or the origin is wrong, because Google's
# redirect_uri_mismatch leaves no log anywhere.
GOOGLE_REDIRECT_URI=http://localhost:8787/v1/auth/google/callback
# HMAC secret for the OAuth state and Google sessions. Generate: openssl rand -hex 32
# Required in production; blank falls back to DEV_AUTH_SECRET elsewhere.
GOOGLE_SESSION_SECRET=

# ── what is on sale (undecided — nothing is sold until this is set)
# A JSON array; amounts in yen, tax included. A price change is a new
# "version", never an edit. Example, one-off pack and a monthly plan:
# CATALOGUE_JSON=[{"price_key":"ink_10","version":1,"kind":"one_time","display_name":"墨 · 10","amount_minor":500,"units":10,"validity_days":180},{"price_key":"ink_month","version":1,"kind":"subscription","display_name":"墨 · 月","amount_minor":980,"units":30}]
CATALOGUE_JSON=
# A first-sign-in gift of credits; at most 2.
FEATURE_FREE_TRIAL_ENABLED=false
FREE_TRIAL_UNITS=2
FEATURE_SUBSCRIPTIONS_ENABLED=false

# ── card payments: simulated | stripe ("simulated" is rejected in production)
PAYMENTS_ADAPTER=simulated
STRIPE_SECRET_KEY=
# Must start with whsec_ (the endpoint signing secret, not an API key).
STRIPE_WEBHOOK_SECRET=
# Publishable key only — a secret key never reaches the browser.
STRIPE_PUBLISHABLE_KEY=
# One price id per catalogue row: STRIPE_PRICE_ID_<PRICE_KEY in capitals>,
# e.g. STRIPE_PRICE_ID_INK_10=price_... The API names any missing one and
# refuses to start with PAYMENTS_ADAPTER=stripe.
# Pinned API version; required in production.
STRIPE_API_VERSION=2025-03-31.basil
# Declares Alipay / WeChat Pay on one-off checkouts (enable them in Stripe first).
STRIPE_WALLETS_ENABLED=false
# What one customer may buy in a rolling day; 0 removes that half of the cap.
PURCHASE_CAP_JPY_PER_DAY=50000
PURCHASE_CAP_ORDERS_PER_DAY=20
# Hold paid card orders for a person to look at (delivery is held, never the payment).
CARD_REVIEW_ENABLED=true
CARD_REVIEW_NEW_ACCOUNT_MINUTES=60
CARD_REVIEW_NEW_ACCOUNT_VALUE_MINOR=5000
CARD_REVIEW_VELOCITY_ORDERS=10

# ── 特定商取引法 disclosure. Production refuses to start without name and
# contact. Keep real details out of this file; your .env is gitignored.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_REPRESENTATIVE=
LEGAL_ENTITY_CONTACT=
LEGAL_ENTITY_PHONE=

# ── stablecoin (JPYC / USDC on Polygon). Every switch off is the shipping
# state; turning one on is a decision about licensing, tax and terms.
STABLECOIN_ENABLED=false
STABLECOIN_JPYC_ENABLED=false
# USDC is priced from live USD/JPY (Coinbase, cross-checked with Frankfurter);
# a quote is refused when either is down, stale or they disagree.
STABLECOIN_USDC_ENABLED=false
STABLECOIN_CHAIN_ID=137
# The receiving wallet's public address only. Its key never enters this repo.
STABLECOIN_RECEIVER_ADDRESS=
# Two nodes from two DIFFERENT companies (they must agree). They carry API keys.
POLYGON_RPC_PRIMARY_URL=
POLYGON_RPC_SECONDARY_URL=
# Below the lower of the two providers' eth_getLogs range caps.
STABLECOIN_SCAN_MAX_SPAN=450
STABLECOIN_SCAN_OVERLAP=32
# Blank = start from the finalized head on the first pass (not block zero).
STABLECOIN_SCAN_START_BLOCK=
STABLECOIN_QUOTE_TTL_SECONDS=600
STABLECOIN_USDC_BUFFER_BPS=100
STABLECOIN_RATE_MAX_DIVERGENCE_BPS=300
STABLECOIN_RATE_REFERENCE_MAX_AGE_HOURS=96
STABLECOIN_CONFIG_VERSION=1
