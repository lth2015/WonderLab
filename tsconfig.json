{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@wonderlab/contracts": [
        "./server/packages/contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "build-info.ts",
    "share-meta.ts"
  ]
}
