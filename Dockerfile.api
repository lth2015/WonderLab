FROM node:22.13.1-bookworm-slim AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS web-build

COPY . .
# .git is not in the image, so pass in which build this is (docs/验证路线图.md §2):
# --build-arg WW_EXPERIMENT=poc-r1 --build-arg WW_BUILD_SHA=<12-char commit>.
# Without them the site is a development build.
ARG WW_EXPERIMENT=dev
ARG WW_BUILD_SHA=unknown
RUN WW_EXPERIMENT=$WW_EXPERIMENT WW_BUILD_SHA=$WW_BUILD_SHA npm run build

FROM node:22.13.1-bookworm-slim AS runtime

ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /etc/ssl/certs/rds-global-bundle.pem
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && chmod 0644 /etc/ssl/certs/rds-global-bundle.pem \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    WEB_DIST_DIR=/app/dist \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem
WORKDIR /app

RUN groupadd --gid 10001 wonderlab \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin wonderlab

COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=web-build /app/dist ./dist
COPY package.json tsconfig.json ./
COPY src ./src
COPY server ./server

USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./node_modules/.bin/tsx", "--tsconfig", "server/tsconfig.json", "server/src/index.ts"]
