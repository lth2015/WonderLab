{
  "name": "wonderlab",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "art": "tsx scripts/gen-art.mjs",
    "fonts": "node scripts/subset-font.mjs",
    "analyze": "tsx scripts/analyze-sessions.ts",
    "server": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "server:start": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:up": "docker compose up -d mysql mysql-test",
    "db:migrate": "tsx --tsconfig server/tsconfig.json server/packages/db/src/cli.ts migrate"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jose": "^5.10.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.7.0",
    "three": "^0.186.1",
    "viem": "^2.57.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
